---
import profile from "../data/profile.json";
---

<footer
  id="contact"
  class="relative py-20 sm:py-28 md:py-36 bg-surface-950 text-white overflow-hidden"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section header -->
    <div class="mb-12 sm:mb-16 max-w-3xl" data-animate>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white tracking-tight mb-4">
        Contact
      </h2>
      <p class="text-lg text-surface-300">Get in touch by email or LinkedIn.</p>
    </div>

    <!-- Contact details -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3" data-animate>
      <!-- Email -->
      <a
        href={`mailto:${profile.email}`}
        class="group block p-6 sm:p-8 bg-surface-900 hover:bg-primary-700 rounded-sm transition-colors duration-200"
      >
        <p class="text-sm font-medium text-surface-400 mb-2">Email</p>
        <p class="text-lg text-white group-hover:text-accent-400 font-semibold break-all transition-colors">
          {profile.email}
        </p>
      </a>

      <!-- LinkedIn -->
      {
        profile.social.linkedin && (
          <a
            href={profile.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="group block p-6 sm:p-8 bg-surface-900 hover:bg-primary-700 rounded-sm transition-colors duration-200"
          >
            <p class="text-sm font-medium text-surface-400 mb-2">LinkedIn</p>
            <p class="text-lg text-white group-hover:text-accent-400 font-semibold transition-colors">
              {profile.name}
            </p>
          </a>
        )
      }

      <!-- Location -->
      <div class="p-6 sm:p-8 bg-surface-900 rounded-sm">
        <p class="text-sm font-medium text-surface-400 mb-2">Location</p>
        <p class="text-lg text-white font-semibold">{profile.location}</p>
      </div>
    </div>

    <!-- Footer bottom -->
    <div class="mt-20 sm:mt-28 flex flex-col sm:flex-row sm:items-end justify-between gap-6">
      <p class="text-2xl font-bold tracking-tight text-surface-200">
        {profile.name}
      </p>
      <p class="text-sm text-surface-400">
        © {new Date().getFullYear()} · Built with Astro &amp; Tailwind
      </p>
    </div>
  </div>
</footer>
