---
import experience from '../data/experience.json';
import profile from '../data/profile.json';
---

<section id="experience" class="py-20 sm:py-28 md:py-36 bg-surface-50 text-surface-900">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="mb-12 sm:mb-16 max-w-3xl" data-animate>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-surface-900 tracking-tight mb-4">Professional Experience</h2>
      <p class="text-lg text-surface-700">My academic and professional background in the world of finance.</p>
    </div>

    <!-- Legend -->
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mb-10 text-sm font-medium text-surface-700" data-animate>
      <span class="inline-flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-primary-500"></span>Education</span>
      <span class="inline-flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-accent-500"></span>Work experience</span>
    </div>

    <!-- Timeline: period, rail with marker, entry -->
    <ol class="relative before:absolute before:top-2 before:bottom-2 before:left-[7px] md:before:left-[211px] before:w-0.5 before:bg-surface-300">
      {experience.map((exp) => {
        const isWork = exp.type === 'work';
        return (
          <li class="relative pl-10 md:pl-0 md:grid md:grid-cols-[180px_1fr] md:gap-x-16 pb-8 last:pb-0" data-animate>
            {/* Marker on the rail */}
            <span
              aria-hidden="true"
              class={`absolute left-0 md:left-[204px] top-1 w-4 h-4 rounded-full ring-4 ring-surface-50 ${isWork ? 'bg-accent-500' : 'bg-primary-500'}`}
            ></span>

            {/* Period + type */}
            <div class="md:text-right mb-3 md:mb-0 md:pt-0.5">
              <p class="text-base font-semibold text-surface-900 tabular-nums leading-snug">{exp.period}</p>
              <p class={`text-sm font-medium mt-0.5 ${isWork ? 'text-accent-600' : 'text-primary-500'}`}>
                {isWork ? 'Work experience' : 'Education'}
              </p>
            </div>

            {/* Entry */}
            <div class="bg-white rounded-sm p-5 sm:p-7">
              <h3 class="text-xl sm:text-2xl font-semibold text-surface-900 tracking-tight mb-1">
                {exp.role}
              </h3>
              <p class="text-base font-medium text-primary-500 mb-4">
                {exp.company}
              </p>
              <p class="text-surface-700 whitespace-pre-line leading-relaxed text-base max-w-[65ch]">
                {exp.description}
              </p>
            </div>
          </li>
        );
      })}
    </ol>

    <!-- Skills and Languages -->
    <div class="mt-16 sm:mt-24 grid grid-cols-1 md:grid-cols-2 gap-12" data-animate>
      <div>
        <h3 class="text-2xl font-semibold text-surface-900 tracking-tight mb-5">Core Skills</h3>
        <ul class="flex flex-wrap gap-2">
          {profile.skills.map((skill) => (
            <li class="px-3 py-1.5 rounded-sm bg-surface-200 text-sm font-medium text-surface-800">
              {skill}
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-2xl font-semibold text-surface-900 tracking-tight mb-5">Languages</h3>
        <ul class="space-y-2 text-base text-surface-800">
          {profile.languages.map((lang) => (
            <li>
              <span class="font-semibold">{lang.name}:</span>
              <span class="text-surface-600">{lang.level}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
