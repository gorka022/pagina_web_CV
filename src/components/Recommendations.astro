---
import recommendations from "../data/recommendations.json";
---

<section
  id="recommendations"
  class="py-20 sm:py-28 md:py-36 bg-surface-100 text-surface-900"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="mb-12 sm:mb-16 max-w-3xl" data-animate>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-surface-900 tracking-tight mb-4">
        Recommendation Letters
      </h2>
      <p class="text-lg text-surface-700">
        Recommendation letters from my academic career.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-8">
      {
        recommendations.map((rec) => (
          <div
            class="glass p-5 sm:p-7 rounded-sm relative group"
            data-animate
          >
            <div class="flex items-start gap-4">
              {rec.avatar && (
                <img
                  src={rec.avatar}
                  alt={rec.name}
                  width="48"
                  height="48"
                  loading="lazy"
                  class="w-12 h-12 rounded-full object-cover flex-shrink-0"
                />
              )}
              {!rec.avatar && (
                <div class="w-12 h-12 rounded-sm bg-primary-500 flex items-center justify-center text-white font-semibold text-sm flex-shrink-0">
                  {rec.name.includes('&') ? rec.name.split('&').map(n => n.trim().charAt(0)).join('&') : rec.name.charAt(0)}
                </div>
              )}
              <div>
                {rec.profileUrl ? (
                  <a
                    href={rec.profileUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-lg text-surface-900 font-semibold hover:text-primary-500 transition-colors inline-flex items-center gap-1 group/link"
                  >
                    {rec.name}
                    <svg
                      aria-hidden="true"
                      class="w-3.5 h-3.5 opacity-0 group-hover/link:opacity-100 transition-opacity"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2.5"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                      />
                    </svg>
                  </a>
                ) : (
                  <span class="text-lg text-surface-900 font-semibold">
                    {rec.name}
                  </span>
                )}
                <p class="text-primary-500 text-sm font-medium mt-1">
                  {rec.role}
                </p>
                <p class="text-surface-600 text-sm">
                  {rec.university}
                </p>
                {rec.date && (
                  <p class="text-surface-600 text-sm mt-1 mb-4 tabular-nums">
                    {rec.date}
                  </p>
                )}
                {rec.pdfUrl && (
                  <button
                    onclick={`openPDFModal('${rec.pdfUrl}#toolbar=0', 'Recommendation')`}
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-sm bg-primary-500 text-white hover:bg-primary-600 font-semibold text-sm transition-colors duration-200 whitespace-nowrap cursor-pointer"
                  >
                    <svg
                      aria-hidden="true"
                      class="w-4 h-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"
                      />
                    </svg>
                    View PDF
                  </button>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

