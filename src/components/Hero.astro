---
import profile from '../data/profile.json';
---

<section id="hero" class="relative min-h-[100svh] flex items-center overflow-hidden pt-16 sm:pt-20 bg-surface-950 text-white">
  <div class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="text-center">
      <!-- Status -->
      <p class="animate-fade-in-up stagger-1 text-sm sm:text-base font-medium text-accent-400 mb-5 sm:mb-7">
        PhD Candidate in Quantitative Finance and Economics
      </p>

      <!-- Name -->
      <h1 class="animate-fade-in-up stagger-2 text-[2.75rem] sm:text-6xl md:text-7xl lg:text-8xl font-extrabold tracking-[-0.035em] leading-[0.95] text-white text-balance mb-5 sm:mb-7">
        {profile.name}
      </h1>

      <!-- Role -->
      <p class="animate-fade-in-up stagger-3 text-lg sm:text-2xl font-medium text-surface-200 mb-5 sm:mb-6 tracking-tight">
        {profile.role}
      </p>

      <!-- Summary -->
      <p class="animate-fade-in-up stagger-4 text-base md:text-lg text-surface-300 max-w-2xl mx-auto mb-8 sm:mb-10 leading-relaxed text-pretty">
        {profile.summary}
      </p>

      <!-- Actions -->
      <div class="animate-fade-in-up stagger-5 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-4 w-full sm:w-auto">
        <a href="#projects" class="group inline-flex items-center justify-center gap-2 px-6 py-3 rounded-sm bg-accent-400 hover:bg-accent-500 text-surface-950 font-semibold transition-colors duration-200 sm:min-w-[180px]">
          View Portfolio
          <svg aria-hidden="true" class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href="/Gorka_Crespo_Bravo_CV.pdf" download class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-sm bg-primary-600 hover:bg-primary-500 text-white font-semibold transition-colors duration-200 sm:min-w-[180px]">
          <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Download CV
        </a>
        <a href="#contact" class="inline-flex items-center justify-center px-4 py-3 text-surface-200 hover:text-accent-400 font-semibold underline underline-offset-4 decoration-surface-600 hover:decoration-accent-400 transition-colors duration-200">
          Contact Me
        </a>
      </div>
    </div>
  </div>
</section>
