---
import projectsData from '../data/projects.json';
import * as fs from 'node:fs';
import * as path from 'node:path';
import process from 'node:process';

const projects = Array.isArray(projectsData) ? projectsData : [];

function getProjectFiles(codeFolder: string, subPath: string = '') {
  if (!codeFolder) return [];
  
  try {
    const root = process.cwd();
    const dirPath = path.join(root, 'public', 'code', codeFolder, subPath);
    
    if (!fs.existsSync(dirPath)) return [];
    
    // Ensure it's a directory
    const stats = fs.statSync(dirPath);
    if (!stats.isDirectory()) return [];

    const entries = fs.readdirSync(dirPath, { withFileTypes: true });
    
    const formattedFiles = entries.map(entry => {
      const relPath = subPath ? `${subPath}/${entry.name}` : entry.name;
      if (entry.isDirectory()) {
        return {
          type: 'folder',
          label: entry.name,
          children: getProjectFiles(codeFolder, relPath)
        };
      } else {
        return {
          type: 'file',
          path: `/code/${codeFolder}/${relPath}`,
          label: entry.name
        };
      }
    });
    
    return formattedFiles.sort((a: any, b: any) => {
      if (a.type === 'folder' && b.type === 'file') return -1;
      if (a.type === 'file' && b.type === 'folder') return 1;
      const aIsMain = a.label.toLowerCase().startsWith('main.');
      const bIsMain = b.label.toLowerCase().startsWith('main.');
      if (aIsMain && !bIsMain) return -1;
      if (!aIsMain && bIsMain) return 1;
      return a.label.localeCompare(b.label);
    });
  } catch (error) {
    console.error(`Error reading directory for ${codeFolder}:`, error);
    return [];
  }
}

const projectsWithFiles = projects.map(project => ({
  ...project,
  codeFiles: getProjectFiles(project.codeFolder)
}));

---

<section id="projects" class="py-20 sm:py-28 md:py-36 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="mb-12 sm:mb-16 max-w-3xl" data-animate>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-surface-900 tracking-tight mb-4">Projects</h2>
      <p class="text-lg text-surface-700">Selection of academic projects and quantitative analysis. Click to view the source code.</p>
    </div>

    <!-- Project Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      {projectsWithFiles.map((project) => {
        const hasCode = project.codeFiles && project.codeFiles.length > 0;
        const codeFilesJSON = hasCode ? JSON.stringify(project.codeFiles) : '[]';
        const fileCount = hasCode ? project.codeFiles.length : 0;
        const langLabel = project.codeLang === 'python' ? 'Python' : project.codeLang === 'r' ? 'R' : project.codeLang;
        const meta = [langLabel, fileCount > 1 ? `${fileCount} files` : ''].filter(Boolean).join(' · ');

        return (
          <div
            class={`project-card group rounded-sm bg-surface-100 hover:bg-primary-50 has-focus-visible:outline-2 has-focus-visible:outline-offset-4 has-focus-visible:outline-primary-600 ${hasCode ? 'cursor-pointer' : ''}`}
            data-animate
            data-code-files={codeFilesJSON}
            data-code-lang={project.codeLang || ''}
            data-project-title={project.title}
            data-long-description={project.longDescription || ''}
          >
            <div class="h-full flex flex-col border-t-4 border-primary-500 rounded-sm">
              <div class="p-6 sm:p-8 flex flex-col flex-1 relative">
                {meta && (
                  <p class="text-sm font-medium text-surface-600 mb-3">{meta}</p>
                )}

                <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-surface-900 group-hover:text-primary-500 transition-colors mb-3">
                  {hasCode ? (
                    <button
                      type="button"
                      aria-haspopup="dialog"
                      class="text-left cursor-pointer focus-visible:outline-none after:absolute after:inset-0"
                      onclick="const d = this.closest('.project-card').dataset; openCodeModal(d.projectTitle, d.codeFiles, d.codeLang, d.longDescription)"
                    >
                      {project.title}
                    </button>
                  ) : project.title}
                </h3>

                <p class="text-surface-700 leading-relaxed mb-6 flex-1 text-base">
                  {project.description}
                </p>

                {hasCode && (
                  <p aria-hidden="true" class="mt-auto inline-flex items-center gap-1.5 text-sm font-semibold text-primary-500">
                    View code
                    <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </p>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
